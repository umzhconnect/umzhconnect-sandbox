# --- Create the DocumentReference
POST {{placer_int_url}}/fhir/DocumentReference
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
<DocumentReference xmlns="http://hl7.org/fhir">
  <id value="DocCardiologyAttachment"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-orf/StructureDefinition/ch-orf-documentreference"/>
  </meta>
  <status value="current"/>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <date value="2025-12-19T16:12:05+01:00"/>
  <description value="Sprechstundenbericht Kardiologie vom 19.12.2025"/>
  <content>
    <attachment>
      <contentType value="application/pdf"/>
      <data value=""/>
      <title value="Sprechstunde_Kardiologie.pdf"/>
    </attachment>
  </content>
</DocumentReference>
HTTP 201
[Captures]
document_reference_id: header "Location" regex ".*/DocumentReference/([^/_?]+).*"

# --- The Placer can create the ServiceRequest
POST {{placer_int_url}}/fhir/ServiceRequest
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
```
<ServiceRequest xmlns="http://hl7.org/fhir">
  <id value="ReferralOrthopedicSurgery"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-umzh-connect/StructureDefinition/ch-umzh-connect-servicerequest"/>
  </meta>
  <identifier>
    <type>
      <coding>
        <system value="http://terminology.hl7.org/CodeSystem/v2-0203"/>
        <code value="PLAC"/>
      </coding>
    </type>
    <value value="REF-2025-001"/>
  </identifier>
  <status value="active"/>
  <intent value="order"/>
  <category>
    <coding>
      <system value="http://snomed.info/sct"/>
      <code value="183545006"/>
      <display value="Referral to orthopedic service (procedure)"/>
    </coding>
  </category>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <authoredOn value="2025-12-15"/>
  <requester>
    <reference value="PractitionerRole/HansMusterRole"/>
  </requester>
  <reasonReference>
    <reference value="Condition/{{main_condition_id}}"/>
  </reasonReference>
  <insurance>
    <reference value="Coverage/{{coverage_id}}"/>
  </insurance>
  <supportingInfo>
    <reference value="Condition/{{supporting_condition_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="MedicationStatement/{{medication_entresto_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="MedicationStatement/{{medication_concor_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="DocumentReference/{{document_reference_id}}"/>
  </supportingInfo>
  <note>
    <text value="Suspected rupture of the left ACL."/>
  </note>
</ServiceRequest>
```
HTTP 201
[Captures]
service_request_id: header "Location" regex ".*/ServiceRequest/([^/_?]+).*"

# --- Create a Consent for the ServiceRequest
POST {{placer_int_url}}/fhir/Consent
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+json
{
  "resourceType": "Consent",
  "status": "active",
  "provision": {
    "period": {"end": "2030-12-31"},
    "actor": [
      {
        "reference": {"reference": "{{registry_url}}/fhir/Organization/HospitalF"}
      }
    ],
    "data": [
      {
        "meaning": "related",
        "reference": {"reference": "ServiceRequest/{{service_request_id}}"}
      }
    ]
  }
}
HTTP 201

# --- Then the Placer can submit a Task to the Fulfiller
POST {{fulfiller_ext_url}}/fhir/Task
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
```
<Task xmlns="http://hl7.org/fhir">
  <id value="TaskReferralOrthopedicSurgery"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-umzh-connect/StructureDefinition/ch-umzh-connect-coordinationtask"/>
  </meta>
  <identifier>
    <system value="urn:ietf:rfc:3986"/>
    <value value="urn:uuid:a8b9cb16-dea5-4e5e-bda1-33f0c5858097"/>
  </identifier>
  <basedOn>
    <reference value="{{placer_ext_url}}/fhir/ServiceRequest/{{service_request_id}}"/>
  </basedOn>
  <status value="requested"/>
  <intent value="order"/>
  <priority value="routine"/>
  <code>
    <coding>
      <system value="http://hl7.org/fhir/CodeSystem/task-code"/>
      <code value="fulfill"/>
      <display value="Fulfill the focal request"/>
    </coding>
  </code>
  <focus>
    <reference value="{{placer_ext_url}}/fhir/ServiceRequest/{{service_request_id}}"/>
  </focus>
  <for>
    <reference value="{{placer_ext_url}}/fhir/Patient/PetraMeier"/>
  </for>
  <authoredOn value="2025-12-15"/>
  <requester>
    <reference value="{{registry_url}}/fhir/Organization/HospitalP"/>
  </requester>
  <owner>
    <reference value="{{registry_url}}/fhir/Organization/HospitalF"/>
  </owner>
</Task>
```
HTTP 201
[Captures]
task_id: header "Location" regex ".*/Task/([^/_?]+).*"

# --- The fulfiller automatically grants access to the Placer
POST {{fulfiller_int_url}}/fhir/Consent
Authorization: Bearer {{fulfiller_cc_token}}
Content-Type: application/fhir+json
{
  "resourceType": "Consent",
  "status": "active",
  "provision": {
    "period": {"end": "2030-12-31"},
    "actor": [
      {
        "reference": {"reference": "{{registry_url}}/fhir/Organization/HospitalP"}
      }
    ],
    "data": [
      {
        "meaning": "related",
        "reference": {"reference": "Task/{{task_id}}"}
      }
    ]
  }
}
HTTP 201

# --- The Fulfiller logs in in the context of that ServiceRequest ---
POST {{keycloak_url}}/realms/umzh-connect/protocol/openid-connect/token
[FormParams]
grant_type: client_credentials
client_id: {{fulfiller_client_id}}
client_secret: {{fulfiller_client_secret}}
authorization_details: [{"type":"umzh-connect-context","identifier":"ServiceRequest/{{service_request_id}}"}]
HTTP 200
[Captures]
fulfiller_context_token: jsonpath "$.access_token"

# --- The Fulfiller has access to the ServiceRequest and the related resources
GET {{placer_ext_url}}/fhir/ServiceRequest?_id={{service_request_id}}&_include=ServiceRequest:patient&_include=ServiceRequest:subject&_include=ServiceRequest:requester&_include=ServiceRequest:reason-reference&_include=ServiceRequest:supporting-info&_include=ServiceRequest:insurance
Authorization: Bearer {{fulfiller_context_token}}
HTTP 200
[Asserts]
body contains "ServiceRequest/{{service_request_id}}"
body contains "Condition/{{main_condition_id}}"
body contains "Coverage/{{coverage_id}}"
body contains "Condition/{{supporting_condition_id}}"
body contains "MedicationStatement/{{medication_entresto_id}}"
body contains "MedicationStatement/{{medication_concor_id}}"
body contains "DocumentReference/{{document_reference_id}}"

# --- The Fulfiller creates a Questionnaire to gather information from the Placer
#     Because of HAPI's limitation regarding paritioning and Questionnaires, we create it in the default partition.
POST {{hapi_url}}/fhir/DEFAULT/Questionnaire
Content-Type: application/fhir+xml
```
<Questionnaire xmlns="http://hl7.org/fhir">
  <id value="QuestionnaireSmokingStatus"/>
  <title value="Smoking Status Inquiry"/>
  <status value="active"/>
  <subjectType value="Patient"/>
  <date value="2026-07-06T19:55:36+00:00"/>
  <publisher value="UMZH Connect Team"/>
  <contact>
    <name value="UMZH Connect"/>
    <telecom>
      <system value="url"/>
      <value value="https://umzhconnect.ch/"/>
    </telecom>
  </contact>
  <description value="Please provide the patient's current smoking status."/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="CHE"/>
    </coding>
  </jurisdiction>
  <copyright value="CC0-1.0"/>
  <item>
    <linkId value="smoking-status"/>
    <text value="What is the patient's smoking status?"/>
    <type value="choice"/>
    <required value="true"/>
    <answerOption>
      <valueCoding>
        <system value="http://snomed.info/sct"/>
        <code value="266919005"/>
        <display value="Never smoked tobacco"/>
      </valueCoding>
    </answerOption>
    <answerOption>
      <valueCoding>
        <system value="http://snomed.info/sct"/>
        <code value="8517006"/>
        <display value="Ex-smoker"/>
      </valueCoding>
    </answerOption>
    <answerOption>
      <valueCoding>
        <system value="http://snomed.info/sct"/>
        <code value="77176002"/>
        <display value="Smoker"/>
      </valueCoding>
    </answerOption>
  </item>
  <item>
    <linkId value="pack-years"/>
    <text value="What is the patient's pack years?"/>
    <type value="decimal"/>
    <required value="false"/>
  </item>
</Questionnaire>
```
HTTP 201
[Captures]
questionnaire_id: header "Location" regex ".*/Questionnaire/([^/_?]+).*"

# --- The Fulfiller requests information from the Placer
PATCH {{fulfiller_int_url}}/fhir/Task/{{task_id}}
Authorization: Bearer {{fulfiller_context_token}}
Content-Type: application/json-patch+json
[
  {
    "op": "replace",
    "path": "/status",
    "value": "in-progress"
  },
  {
    "op": "replace",
    "path": "/owner/reference",
    "value": "{{registry_url}}/fhir/Organization/HospitalP"
  },
  {
    "op": "add",
    "path": "/output/-",
    "value": [{
      "type" : {
        "coding" : [
          {
            "system" : "http://snomed.info/sct",
            "code" : "273510007",
            "display" : "Health assessment questionnaire"
          }
        ]
      },
      "valueCanonical" : "{{fulfiller_ext_url}}/fhir/Questionnaire/{{questionnaire_id}}"
    }]
  },
  {
   "op": "add",
   "path": "/businessStatus",
   "value": {
      "coding" : [
        {
          "system" : "http://hl7.org/fhir/uv/cow/CodeSystem/temp",
          "code" : "awaiting-information"
        }
      ]
    }
  }
]
HTTP 200

# --- The Placer logs in in the context of that Task
POST {{keycloak_url}}/realms/umzh-connect/protocol/openid-connect/token
[FormParams]
grant_type: client_credentials
client_id: {{placer_client_id}}
client_secret: {{placer_client_secret}}
authorization_details: [{"type":"umzh-connect-context","identifier":"Task/{{task_id}}"}]
HTTP 200
[Captures]
placer_context_token: jsonpath "$.access_token"

POST {{keycloak_url}}/realms/umzh-connect/protocol/openid-connect/token/introspect
[FormParams]
token: {{placer_context_token}}
client_id: {{placer_client_id}}
client_secret: {{placer_client_secret}}
HTTP 200

# --- The placer can read the Task and see the Questionnaire
GET {{fulfiller_ext_url}}/fhir/Task?_id={{task_id}}
Authorization: Bearer {{placer_context_token}}
HTTP 200
[Asserts]
body contains "Task/{{task_id}}"
body contains "in-progress"
body contains "Questionnaire/{{questionnaire_id}}"

# --- The placer fills the questionnaire
POST {{placer_int_url}}/fhir/QuestionnaireResponse
Authorization: Bearer {{placer_cc_token}}
<QuestionnaireResponse xmlns="http://hl7.org/fhir">
  <id value="QuestionnaireResponseSmokingStatus"/>
  <basedOn>
    <reference value="{{placer_ext_url}}/fhir/ServiceRequest/{{service_request_id}}"/>
  </basedOn>
  <questionnaire value="{{hapi_url}}/fhir/DEFAULT/Questionnaire/QuestionnaireSmokingStatus"/>
  <status value="completed"/>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <authored value="2025-12-16"/>
  <author>
    <reference value="PractitionerRole/HansMusterRole"/>
  </author>
  <item>
    <linkId value="smoking-status"/>
    <text value="What is the patient's smoking status?"/>
    <answer>
      <valueCoding>
        <system value="http://snomed.info/sct"/>
        <code value="8517006"/>
        <display value="Ex-smoker"/>
      </valueCoding>
    </answer>
  </item>
  <item>
    <linkId value="pack-years"/>
    <text value="What is the patient's pack years?"/>
    <answer>
      <valueDecimal value="50"/>
    </answer>
  </item>
</QuestionnaireResponse>
HTTP 201
[Captures]
questionnaire_response_id: header "Location" regex ".*/QuestionnaireResponse/([^/_?]+).*"

# --- The placer adds a reference to the QuestionnaireResponse in the ServiceRequest to make it accessible
PUT {{placer_int_url}}/fhir/ServiceRequest/{{service_request_id}}
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
```
<ServiceRequest xmlns="http://hl7.org/fhir">
  <id value="{{service_request_id}}"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-umzh-connect/StructureDefinition/ch-umzh-connect-servicerequest"/>
  </meta>
  <identifier>
    <type>
      <coding>
        <system value="http://terminology.hl7.org/CodeSystem/v2-0203"/>
        <code value="PLAC"/>
      </coding>
    </type>
    <value value="REF-2025-001"/>
  </identifier>
  <status value="active"/>
  <intent value="order"/>
  <category>
    <coding>
      <system value="http://snomed.info/sct"/>
      <code value="183545006"/>
      <display value="Referral to orthopedic service (procedure)"/>
    </coding>
  </category>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <authoredOn value="2025-12-15"/>
  <requester>
    <reference value="PractitionerRole/HansMusterRole"/>
  </requester>
  <reasonReference>
    <reference value="Condition/{{main_condition_id}}"/>
  </reasonReference>
  <insurance>
    <reference value="Coverage/{{coverage_id}}"/>
  </insurance>
  <supportingInfo>
    <reference value="Condition/{{supporting_condition_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="MedicationStatement/{{medication_entresto_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="MedicationStatement/{{medication_concor_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="DocumentReference/{{document_reference_id}}"/>
  </supportingInfo>
  <supportingInfo>
    <reference value="QuestionnaireResponse/{{questionnaire_response_id}}"/>
  </supportingInfo>
  <note>
    <text value="Suspected rupture of the left ACL."/>
  </note>
</ServiceRequest>
```
HTTP 200

# --- The Task is assigned to the Fulfiller again
PATCH {{fulfiller_ext_url}}/fhir/Task/{{task_id}}
Authorization: Bearer {{placer_context_token}}
Content-Type: application/json-patch+json
[
  {
    "op": "replace",
    "path": "/owner/reference",
    "value": "{{registry_url}}/fhir/Organization/HospitalF"
  },
  {
    "op": "remove",
    "path": "/businessStatus"
  },
  {
    "op": "add",
    "path": "/input/-",
    "value": [
      {
       "type" : {
         "coding" : [
           {
             "system" : "http://snomed.info/sct",
             "code" : "273510007",
             "display" : "Health assessment questionnaire"
           }
         ]
       },
       "valueReference": {
         "reference": "{{placer_ext_url}}/fhir/QuestionnaireResponse/{{questionnaire_response_id}}"
       }
      }
    ]
  }
]
HTTP 200

# --- The fulfiller reads the QuestionnaireResponse back
GET {{placer_ext_url}}/fhir/QuestionnaireResponse/{{questionnaire_response_id}}
Authorization: Bearer {{fulfiller_context_token}}
HTTP 200
[Asserts]
body contains "8517006"

# --- The fulfiller completes the service: Appointment
POST {{fulfiller_int_url}}/fhir/Appointment
Authorization: Bearer {{fulfiller_cc_token}}
Content-Type: application/fhir+xml
<Appointment xmlns="http://hl7.org/fhir">
  <id value="AppointmentOrthopedicConsultation"/>
  <status value="fulfilled"/>
  <description value="Pre-operative orthopedic consultation prior to ACL reconstruction surgery"/>
  <start value="2026-01-08T09:00:00+01:00"/>
  <end value="2026-01-08T09:30:00+01:00"/>
  <participant>
    <type>
      <coding>
        <system value="http://terminology.hl7.org/CodeSystem/v3-ParticipationType"/>
        <code value="SBJ"/>
        <display value="subject"/>
      </coding>
    </type>
    <status value="accepted"/>
  </participant>
  <participant>
    <actor>
      <reference value="{{registry_url}}/fhir/HealthcareService/HealthcareServiceOrthopedicsFulfiller"/>
    </actor>
    <status value="accepted"/>
  </participant>
</Appointment>
HTTP 201
[Captures]
appointment_id: header "Location" regex ".*/Appointment/([^/_?]+).*"

