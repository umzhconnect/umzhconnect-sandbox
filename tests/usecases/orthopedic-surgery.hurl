HTTP 200
[Asserts]
body contains "Task/{{task_id}}"
body contains "completed"
body contains "Appointment/{{appointment_id}}"
body contains "fulfilled"
body contains "DocumentReference/{{document_reference_id}}"
body contains "373942005"
body contains "MedicationStatement/{{medication_statement_id}}"
body contains "33633005"
body contains "Medication/{{medication_id}}"
body contains "B01AC06"
body contains "QuestionnaireResponse/{{questionnaire_response_id}}"
body contains "Questionnaire/{{questionnaire_id}}"
