# --- Placer client_credentials ---
POST {{keycloak_url}}/realms/umzh-connect/protocol/openid-connect/token
[FormParams]
grant_type: client_credentials
client_id: {{placer_client_id}}
client_secret: {{placer_client_secret}}
HTTP 200
[Captures]
placer_cc_token: jsonpath "$.access_token"

# --- Fulfiller client_credentials ---
POST {{keycloak_url}}/realms/umzh-connect/protocol/openid-connect/token
[FormParams]
grant_type: client_credentials
client_id: {{fulfiller_client_id}}
client_secret: {{fulfiller_client_secret}}
HTTP 200
[Captures]
fulfiller_cc_token: jsonpath "$.access_token"

# --- Create the main Condition
POST {{placer_int_url}}/fhir/Condition
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
<Condition xmlns="http://hl7.org/fhir">
  <id value="SuspectedACLRupture"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-etoc/StructureDefinition/ch-etoc-primary-diagnosis"/>
  </meta>
  <category>
    <coding>
      <system value="http://fhir.ch/ig/ch-etoc/CodeSystem/ch-etoc-conditioncategory"/>
      <code value="primary-diagnosis"/>
    </coding>
  </category>
  <code>
    <text value="Rupture left ACL"/>
  </code>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <note>
    <text
          value="- Suspected rupture of the left anterior cruciate ligament after an accident.
- Clinical examination reveals pain, swelling and subjective instability of the left knee, with a clearly positive Lachman test indicating anterior cruciate ligament insufficiency."/>
  </note>
</Condition>
HTTP 201
[Captures]
main_condition_id: header "Location" regex ".*/Condition/([^/_?]+).*"

# --- Create the Coverage
POST {{placer_int_url}}/fhir/Coverage
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
<Coverage xmlns="http://hl7.org/fhir">
  <id value="CoverageMeier"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-orf/StructureDefinition/ch-orf-coverage"/>
  </meta>
  <contained>
    <Organization>
      <id value="OrganizationKrankenkasse"/>
      <meta>
        <profile value="http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-organization"/>
      </meta>
      <identifier>
        <system value="urn:oid:2.51.1.3"/>
        <value value="7601002331470"/>
      </identifier>
      <name value="Krankenkasse AG"/>
      <address>
        <line value="Kassengraben 222"/>
        <city value="Basel"/>
      </address>
    </Organization>
  </contained>
  <identifier>
    <type>
      <coding>
        <system value="http://fhir.ch/ig/ch-orf/CodeSystem/ch-orf-cs-coverageidentifiertype"/>
        <code value="VeKa"/>
      </coding>
    </type>
    <system value="urn:oid:2.16.756.5.30.1.123.100.1.1.1"/>
    <value value="80756015090002647590"/>
  </identifier>
  <status value="active"/>
  <beneficiary>
    <reference value="Patient/PetraMeier"/>
  </beneficiary>
  <payor>
    <reference value="#OrganizationKrankenkasse"/>
  </payor>
</Coverage>
HTTP 201
[Captures]
coverage_id: header "Location" regex ".*/Coverage/([^/_?]+).*"

# --- Create the supporting Condition
POST {{placer_int_url}}/fhir/Condition
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
<Condition xmlns="http://hl7.org/fhir">
  <id value="HeartFailureHFrEF"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-etoc/StructureDefinition/ch-etoc-secondary-diagnosis"/>
  </meta>
  <category>
    <coding>
      <system value="http://fhir.ch/ig/ch-etoc/CodeSystem/ch-etoc-conditioncategory"/>
      <code value="secondary-diagnosis"/>
    </coding>
  </category>
  <code>
    <coding>
      <system value="http://fhir.de/CodeSystem/bfarm/icd-10-gm"/>
      <code value="I50.22"/>
      <display value="Chronic systolic (congestive) heart failure"/>
    </coding>
    <text value="Chronic heart failure with reduced left ventricular ejection fraction (HFrEF) with moderately limited exercise tolerance, NYHA class II, LVEF &lt;35%."/>
  </code>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
</Condition>
HTTP 201
[Captures]
supporting_condition_id: header "Location" regex ".*/Condition/([^/_?]+).*"

# --- Create the Medication Entresto
POST {{placer_int_url}}/fhir/MedicationStatement
Authorization: Bearer {{placer_cc_token}}
Content-Type: application/fhir+xml
<MedicationStatement xmlns="http://hl7.org/fhir">
  <id value="MedicationEntresto"/>
  <meta>
    <profile value="http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-medicationstatement"/>
  </meta>
  <contained>
    <Medication>
      <id value="MedEntresto"/>
      <meta>
        <profile value="http://fhir.ch/ig/ch-core/StructureDefinition/ch-core-medication"/>
      </meta>
      <code>
        <coding>
          <system value="urn:oid:2.51.1.1"/>
          <code value="7680656730044"/>
          <display value="Entresto (Filmtabl 200 mg) Blist"/>
        </coding>
        <coding>
          <system value="http://www.whocc.no/atc"/>
          <code value="C09DX04"/>
          <display value="Valsartan und Sacubitril"/>
        </coding>
        <text value="Entresto (Filmtabl 200 mg) Blist"/>
      </code>
      <form>
        <coding>
          <system value="urn:oid:0.4.0.127.0.16.1.1.2.1"/>
          <code value="10221000"/>
          <display value="Filmtablette"/>
        </coding>
        <text value="Filmtablette"/>
      </form>
      <ingredient>
        <itemCodeableConcept>
          <coding>
            <system value="http://snomed.info/sct"/>
            <code value="716072000"/>
            <display value="Sacubitril"/>
          </coding>
        </itemCodeableConcept>
      </ingredient>
      <ingredient>
        <itemCodeableConcept>
          <coding>
            <system value="http://snomed.info/sct"/>
            <code value="386876001"/>
            <display value="Valsartan"/>
          </coding>
        </itemCodeableConcept>
      </ingredient>
    </Medication>
  </contained>
  <status value="active"/>
  <medicationReference>
    <reference value="#MedEntresto"/>
  </medicationReference>
  <subject>
    <reference value="Patient/PetraMeier"/>
  </subject>
  <dosage>
    <timing>
      <repeat>
        <boundsPeriod>
          <start value="2025-12-19"/>
        </boundsPeriod>
        <when value="MORN"/>
        <when value="NOON"/>
        <when value="EVE"/>
      </repeat>
    </timing>
    <route>
      <coding>
        <system value="urn:oid:0.4.0.127.0.16.1.1.2.1"/>
        <code value="20053000"/>
        <display value="Oral use"/>
      </coding>
    </route>
    <doseAndRate>
      <doseQuantity>
        <value value="1"/>
        <unit value="Stk"/>
        <system value="http://unitsofmeasure.org"/>
        <code value="{Piece}"/>
      </doseQuantity>
    </doseAndRate>
  </dosage>
</MedicationStatement>
HTTP 201
[Captures]
medication_entresto_id: header "Location" regex ".*/MedicationStatement/([^/_?]+).*"

