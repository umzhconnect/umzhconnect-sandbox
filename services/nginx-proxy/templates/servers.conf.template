# =============================================================================
# nginx-proxy server blocks — processed by envsubst at container start.
# Variables are resolved from the environment (see docker-compose.yml).
#
#   VITE_PLACER_URL          → placer   internal base URL  (port 80)
#   VITE_PLACER_EXTERNAL_URL → placer   external base URL  (port 81)
#   VITE_FULFILLER_URL       → fulfiller internal base URL (port 82)
#   VITE_FULFILLER_EXTERNAL_URL → fulfiller external base URL (port 83)
#   VITE_REGISTRY_URL        → registry base URL           (port 84)
#   HAPI_FHIR_BASE_URL       → FHIR backend (http:// or https://, any host/port)
#   HAPI_FHIR_SELF_LINK_URL  → that backend's own hapi.fhir.server_address
#   HAPI_FHIR_AUTH_HEADER    → optional technical credential for that backend,
#                              e.g. "Basic <base64 of user:pass>"; empty by
#                              default, in which case nginx omits the header
#   HAPI_FHIR_STRIP_PARTITION_PREFIX → set to "1" for a real single-party
#                              deployment against a real FHIR server that has
#                              no /fhir/{party}/ partitioning of its own (the
#                              bundled hapi-fhir container needs this segment
#                              kept, hence opt-in rather than the default)
# =============================================================================

# -----------------------------------------------------------------
# Port 80 -- Placer internal gateway (APISIX port 8080)
# -----------------------------------------------------------------
server {
    listen 80;

    location / {
        set                      $strip_partition "${HAPI_FHIR_STRIP_PARTITION_PREFIX}";
        set                      $hapi_upstream "${HAPI_FHIR_BASE_URL}";
        set                      $self_link_needle "${HAPI_FHIR_SELF_LINK_URL}/fhir/placer/";
        if ($strip_partition = "1") {
            rewrite ^/fhir/placer/(.*)$ /$1 break;
            set $self_link_needle "${HAPI_FHIR_SELF_LINK_URL}/";
        }
        proxy_pass               $hapi_upstream$uri$is_args$args;
        proxy_ssl_server_name    on;
        proxy_set_header        Host               $proxy_host;
        proxy_set_header        X-Real-IP          $remote_addr;
        proxy_set_header        X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header        Accept-Encoding    "";
        proxy_set_header        Authorization      "${HAPI_FHIR_AUTH_HEADER}";

        sub_filter_once  off;
        sub_filter_types *;
        sub_filter "$self_link_needle" "${VITE_PLACER_URL}/fhir/";
    }
}

