# -----------------------------------------------------------------
# Port 84 -- Registry gateway (public, no auth)
# Rewrites /fhir/* → /fhir/registry/* on HAPI and fixes self-links.
# -----------------------------------------------------------------
server {
    listen 84;

    location /fhir/ {
        set                      $hapi_upstream "${HAPI_FHIR_BASE_URL}";
        rewrite ^/fhir/(.*)$ /fhir/registry/$1 break;
        proxy_pass               $hapi_upstream$uri$is_args$args;
        proxy_ssl_server_name    on;
        proxy_set_header        Host               $proxy_host;
        proxy_set_header        X-Real-IP          $remote_addr;
        proxy_set_header        X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header        Accept-Encoding    "";
        proxy_set_header        Authorization      "${HAPI_FHIR_AUTH_HEADER}";

        sub_filter_once  off;
        sub_filter_types *;
        sub_filter "${HAPI_FHIR_SELF_LINK_URL}/fhir/registry/" "${VITE_REGISTRY_URL}/fhir/";
    }
}
