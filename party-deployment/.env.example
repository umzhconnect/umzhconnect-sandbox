# =============================================================================
# party-deployment — single-party ecosystem node configuration
# =============================================================================
# Copy to `.env` and adjust. Defaults below deploy the node AS the fulfiller,
# pointing at the running two-party sandbox as the "external" ecosystem
# (Keycloak :8180, registry :8084, partner placer-external :8081) — so you can
# try it without standing up separate shared infrastructure.
#
# To deploy as the placer instead: set PARTY=placer, PARTNER_REALM_ROLE=fulfiller,
# L2_CLIENT_ID=placer-client-l2, L2_KID=placer-l2, PARTNER_EXTERNAL_URL to the
# fulfiller's external gateway, and OWN_EXTERNAL_URL to this node's public URL.

# ── This party's identity ────────────────────────────────────────────────────
PARTY=fulfiller
# Realm role the *partner* presents (OPA allow-list on the external gateway).
PARTNER_REALM_ROLE=placer
# This party's L2 (private_key_jwt) client, pre-registered in the auth server
# with its jwks.url pointing at OWN_EXTERNAL_URL/jwks.json (see README).
L2_CLIENT_ID=fulfiller-client-l2
L2_KID=fulfiller-l2

# ── Ecosystem-shared services (NOT deployed here — fetched from here) ─────────
# Auth server (Keycloak or any OIDC provider that issues the ecosystem tokens).
# AUTH_SERVER_URL    = where this node reaches it (backchannel: token POST, JWKS).
# AUTH_SERVER_PUBLIC_URL = the issuer/audience the auth server advertises; the
#   client assertion's `aud` must equal this. In a normal deployment the auth
#   server has one public URL, so set both equal. They differ here only because
#   the sandbox Keycloak advertises localhost:8180 but is reached via
#   host.docker.internal:8180 from inside this node's containers.
AUTH_SERVER_URL=http://host.docker.internal:8180
AUTH_SERVER_PUBLIC_URL=http://localhost:8180
AUTH_SERVER_REALM=umzh-connect
# Partner hospital's external gateway base (no trailing /fhir).
PARTNER_EXTERNAL_URL=http://host.docker.internal:8081
# mCSD Organization/Endpoint registry base (no trailing /fhir).
REGISTRY_URL=http://host.docker.internal:8084

# ── This party's own public URLs ──────────────────────────────────────────────
# OWN_EXTERNAL_URL MUST equal the host:port the partner (and the auth server's
# jwks.url for this client) use to reach this node's external gateway.
OWN_EXTERNAL_URL=http://localhost:9081
OWN_INTERNAL_URL=http://localhost:9080

# ── Host port mappings for this node's containers ────────────────────────────
INTERNAL_GATEWAY_PORT=9080
EXTERNAL_GATEWAY_PORT=9081
HAPI_PORT=9090
OPA_PORT=9181
KEY_CUSTODIAN_PORT=9087
KESTRA_PORT=9088
POSTGRES_PORT=5532

# ── Postgres (HAPI + Kestra) — must match services/hapi-fhir/application.yaml ─
POSTGRES_USER=umzh
POSTGRES_PASSWORD=umzh_sandbox_2025
POSTGRES_DB=hapi_fhir
